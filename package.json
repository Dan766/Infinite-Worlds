    "test": "vitest run",
    "shot": "node scripts/shot.mjs",
    "shots": "node scripts/shots.mjs",
    "shots:check": "node scripts/shots-check.mjs",
    "shots:diff": "node scripts/shots-diff.mjs",
    "shots:repeat": "node scripts/shots-repeat.mjs",
    "soak": "node scripts/soak.mjs",
    "verify:subpath": "node scripts/verify-subpath.mjs",
    "deploy:firebase": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "firebase-tools": "^14.3.0",
    "lil-gui": "^0.21.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
